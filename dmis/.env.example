# ── Database ─────────────────────────────────────────────────────────────
# Local dev example; production value points at the Render-provisioned
# PostgreSQL instance (set in Render's dashboard, never committed here).
DATABASE_URL="postgresql://dmis_user:dmis_password@localhost:5432/dmis_dev?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate a real random value for every environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production (min 32 chars) — the server refuses to start without it.
JWT_SECRET="replace-with-a-long-random-value-never-commit-the-real-one"
JWT_EXPIRES_IN="8h"

# ── API server ───────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV="development"

# ── CORS ─────────────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"
# Comma-separated list; include the deployed web URL and, if relevant, the
# scheme used by the Flutter app's HTTP client in dev.
CORS_ORIGINS="http://localhost:5173"

# ── Web app (apps/web) ───────────────────────────────────────────────────
# Dev: leave as /api — Vite proxies it to the API (no CORS needed). Production: full API URL, e.g. https://dmis-api.onrender.com/api
VITE_API_BASE_URL="/api"

# ── Mobile app (apps/mobile) ─────────────────────────────────────────────
# Set at build time / in Flutter's environment config, not read from this
# file directly — documented here so the variable name stays consistent.
# MOBILE_API_BASE_URL="http://localhost:4000/api"

# ── Seed (npm run db:seed) ───────────────────────────────────────────────
# Bootstraps the first ADMIN account (registration is admin-only). Choose
# your own strong password; leave both blank to skip. Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
